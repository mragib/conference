doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Abstract Review Invitation - SCM Conference 2026

  body(style="margin:0; padding:0; background-color:#FDFCFB; font-family:'Segoe UI', Arial, sans-serif;")
    .wrapper(style="padding:30px 10px;")
      .container(style="max-width:600px; margin:auto; background:#ffffff; border-radius:20px; overflow:hidden; box-shadow:0 10px 30px rgba(0,0,0,0.05); border:1px solid #f1f5f9;")

        //- HEADER
        include header

        .content(style="padding:40px;")

          h2(style="color:#003366; font-size:20px; font-weight:900; margin-top:0;")
            | Dear #{name},

          p(style="color:#475569; font-size:15px; line-height:1.8;")
            | You have been invited to review the following abstract for the SCM Conference 2026:

          //- ABSTRACT BOX
          .abstract-box(style="margin:25px 0; padding:20px; background:#f8fafc; border:1px solid #e2e8f0; border-radius:12px;")
            p(style="margin:0; font-size:12px; color:#64748b; text-transform:uppercase; font-weight:bold;")
              | Abstract Title

            p(style="margin:8px 0 0; font-size:16px; color:#003366; font-weight:800;")
              | #{abstract_title}

          p(style="color:#475569; font-size:15px; line-height:1.8;")
            | Please confirm whether you are willing to review this abstract by selecting one of the options below:

          //- ACTION BUTTONS
          .actions(style="text-align:center; margin:30px 0;")

            a(
              href=agree_link
              style="display:inline-block; margin:5px; padding:12px 22px; background:#16a34a; color:#ffffff; text-decoration:none; border-radius:10px; font-size:12px; font-weight:900; text-transform:uppercase; letter-spacing:1px;"
            )
              | Accept Review

            a(
              href=disagree_link
              style="display:inline-block; margin:5px; padding:12px 22px; background:#dc2626; color:#ffffff; text-decoration:none; border-radius:10px; font-size:12px; font-weight:900; text-transform:uppercase; letter-spacing:1px;"
            )
              | Decline

          //- FALLBACK LINKS
          p(style="color:#64748b; font-size:12px; margin-top:20px;")
            | If the buttons do not work, use the links below:

          p(style="font-size:12px; word-break:break-all;")
            strong Accept:
            |  #{agree_link}

          p(style="font-size:12px; word-break:break-all;")
            strong Decline:
            |  #{disagree_link}

          //- EXPIRY NOTICE
          .notice(style="margin-top:25px; padding:15px; background:#fff7ed; border:1px solid #fed7aa; border-radius:10px;")
            p(style="margin:0; font-size:12px; color:#c2410c; font-weight:600;")
              | ⏳ This invitation will expire soon. Please respond promptly.

          //- SIGNATURE
          .footer-sign(style="margin-top:30px; border-top:1px solid #f1f5f9; padding-top:20px;")
            p(style="margin:0; color:#003366; font-weight:900;")
              | Regards,

            p(style="margin:2px 0 0; color:#64748b; font-weight:600;")
              | Organizing Committee  
              br
              | Conference SCM 2026

        //- FOOTER
        include footer